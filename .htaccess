<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /chirper/

    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    # Route /storage/ to public upload directory so Apache can serve files directly.
    # Runs once (REDIRECT_STATUS prevents loop). Non-existent files fall through to Laravel.
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^storage/(.*)$ storage/app/public/$1 [L]

    # Protect Laravel core directories.
    # Pattern matches stripped path (per-directory context), not REQUEST_URI.
    # Skipped after internal rewrite (REDIRECT_STATUS set).
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor)(/|$) - [F,L]

    # Allow public assets
    RewriteCond %{REQUEST_URI} ^/public
    RewriteRule ^.*$ - [L]

    RewriteRule ^(build|assets|geojson|images|vendor)/(.*)$ public/$1/$2 [L]
    RewriteRule ^(favicon\.ico|robots\.txt)$ public/$1 [L]

    # Redirect if fail
    # RewriteCond %{REQUEST_URI} !^/public/
    # RewriteRule ^(.*)$ public/$1 [L,R=302]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Route all non-files / non-dirs to Laravel
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^chirper/(.*)$ public/index.php [L]
    RewriteRule ^ index.php [L]
</IfModule>
